---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ServiceOverview from "../../components/servics/slug/ServiceOverview.astro";
import FeaturesSection from "../../components/servics/slug/FeaturesSection.astro";
import BenefitsSection from "../../components/servics/slug/BenefitsSection.astro";
import ProcessSection from "../../components/servics/slug/ProcessSection.astro";
import FAQSection from "../../components/servics/slug/FAQSection.astro";
import CTASection from "../../components/servics/slug/CTASection.astro";
import RelatedServices from "../../components/servics/slug/RelatedServices.astro";
import { services, getRelatedServices } from "../../data/services";

export function getStaticPaths() {
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect('/servicios');
}

const relatedServices = getRelatedServices(service.slug, 3);

// Mapeo de colores robusto (Modern Medical Style)
const colorClasses = {
  green: {
    bgLight: "bg-emerald-50",
    text: "text-emerald-600",
    icon: "bg-emerald-500",
    gradient: "from-emerald-500 to-teal-600",
    blob: "bg-emerald-200"
  },
  blue: {
    bgLight: "bg-blue-50",
    text: "text-blue-600",
    icon: "bg-blue-500",
    gradient: "from-blue-500 to-indigo-600",
    blob: "bg-blue-200"
  },
  yellow: {
    bgLight: "bg-amber-50",
    text: "text-amber-600",
    icon: "bg-amber-500",
    gradient: "from-amber-400 to-orange-500",
    blob: "bg-amber-200"
  },
  pink: {
    bgLight: "bg-pink-50",
    text: "text-pink-600",
    icon: "bg-pink-500",
    gradient: "from-pink-500 to-rose-600",
    blob: "bg-pink-200"
  },
  purple: {
    bgLight: "bg-purple-50",
    text: "text-purple-600",
    icon: "bg-purple-500",
    gradient: "from-purple-500 to-violet-600",
    blob: "bg-purple-200"
  },
  teal: {
    bgLight: "bg-teal-50",
    text: "text-teal-600",
    icon: "bg-teal-500",
    gradient: "from-teal-500 to-cyan-600",
    blob: "bg-teal-200"
  }
};

const colors = colorClasses[service.color as keyof typeof colorClasses] || colorClasses.blue;
---

<Layout title={`${service.title} | Pediatría Dharma`} description={service.shortDesc}>
  <Hero
    title={service.title}
    subtitle={service.shortDesc}
    backgroundImage={service.image}
  />

  <main class="main-section overflow-hidden bg-white">
  <span class="cloud cloud--1" aria-hidden="true"></span>
  <span class="cloud cloud--2" aria-hidden="true"></span>
  <span class="cloud cloud--3" aria-hidden="true"></span>
  <span class="cloud cloud--4" aria-hidden="true"></span>
  <span class="cloud cloud--5" aria-hidden="true"></span>
  <span class="cloud cloud--6" aria-hidden="true"></span>
  <span class="cloud cloud--7" aria-hidden="true"></span>
  <span class="cloud cloud--8" aria-hidden="true"></span>
  <span class="cloud cloud--9" aria-hidden="true"></span>
  <span class="cloud cloud--10" aria-hidden="true"></span>
  <span class="cloud cloud--11" aria-hidden="true"></span>
  <span class="cloud cloud--12" aria-hidden="true"></span>

    <ServiceOverview service={service} colors={colors} />
    <FeaturesSection service={service} colors={colors} />
    <BenefitsSection service={service} colors={colors} />
    <ProcessSection service={service} colors={colors} />
    <FAQSection service={service} colors={colors} />
    <span class="cloud cloud--10" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <CTASection service={service} colors={colors} />
    <RelatedServices relatedServices={relatedServices} />

  </main>
</Layout>

<style>
  /* Refuerzo de tipografía y suavizado */
  h2, h3 {
    text-wrap: balance;
  }
</style>