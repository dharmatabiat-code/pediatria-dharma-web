---
import Layout from "../layouts/Layout.astro";
import { company } from "../data/company";
import InformationSection from "../components/reserva/InformationSection.astro";
import FormSection from "../components/reserva/FormSection.astro";
import AyudaSection from "../components/reserva/AyudaSection.astro";
import TitleSection from "../components/reserva/TitleSection.astro";
---

<Layout
  title={`Reserva tu Cita | ${company.name}`}
  description="Agenda una cita médica para tu hijo en nuestra clínica pediátrica en Huamanga, Ayacucho. Atención especializada con amor y profesionalismo."
>
  <main class="main-section overflow-hidden">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
    <span class="cloud cloud--6" aria-hidden="true"></span>
    <span class="cloud cloud--7" aria-hidden="true"></span>
    <span class="cloud cloud--8" aria-hidden="true"></span>

    <TitleSection />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12 lg:pb-24 relative pt-24 md:pt-40 overflow-hidden">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-start">
        
        <div class="lg:col-span-5 order-2 lg:order-2">
          <InformationSection />
        </div>

        <div class="lg:col-span-7 order-1 lg:order-1">
          <FormSection />
        </div>

      </div>
    </div>

    <AyudaSection />
    
  </main>
</Layout>

<style>
  /* Asegúrate de que las nubes no causen scroll horizontal en móviles */
  .main-section {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }
</style>