---
// Tu código de importaciones permanece igual
import Layout from "../layouts/Layout.astro";
import TitleSection from "../components/contacto/TitleSection.astro";
import ContactSidebar from "../components/contacto/ContactSidebar.astro";
import ContactMapCard from "../components/contacto/ContactMapCard.astro";
import CtaSection from "../components/contacto/CtaSection.astro";
import { company } from "../data/company.js";
// Limpia el teléfono para el href tel:
const phoneHref = String(company.contact.phone).replace(/[^\d+]/g, "");
---

<Layout title={`Contacto | ${company.name}`}>

  <main class="main-section">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>

    <!-- Sección de contacto: Cards con imágenes y overlays mejorados, animaciones de entrada -->
    <section
      id="contact-section"
      class="relative overflow-hidden px-4 pb-10 rounded-3xl shadow-lg"
    >

     <TitleSection />

      <div class="max-w-350 mx-auto">
      
        <div class="grid lg:grid-cols-12 gap-8 items-start relative pt-24 md:pt-40 overflow-hidden">
          <div class="lg:col-span-4">
          <ContactSidebar company={company} />
          </div>
         
          <div class="lg:col-span-8 space-y-8">
            <div>
              <ContactMapCard company={company} />
            </div>
          </div>
        </div>
      </div>

      <div>
          <CtaSection />
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Lucide (si está cargado por CDN)
    if (window.lucide?.createIcons) window.lucide.createIcons();

    // Ocultar loader al cargar el iframe
    const iframe = document.getElementById("contact-map");
    const mapCard = document.getElementById("map-card");
    const loader = mapCard?.querySelector(".map-loader");

    iframe?.addEventListener("load", () => {
      if (loader) loader.style.display = "none";
    });
  });
</script>
