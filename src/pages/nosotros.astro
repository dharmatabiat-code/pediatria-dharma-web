---
import { company } from '../data/company';

import Layout from '../layouts/Layout.astro';
import TitleSection from '../components/about/TitleSection.astro';
import VisionMissionSection from '../components/about/Vision-MissionSection.astro';
import ValuesSection from '../components/about/ValuesSection.astro';
import HistorySection from '../components/about/HistorySection.astro';
---

<Layout title={`Nosotros | ${company.name}`}  
description="Conoce la historia, misión y visión de nuestra clínica pediátrica. Descubre cómo cuidamos de tus hijos con amor y profesionalismo.">

  <!-- Sección de propósito: Grid con imágenes y texto -->
  <main class="main-section">
    <span class="cloud cloud--1" aria-hidden="true"></span>
    <span class="cloud cloud--2" aria-hidden="true"></span>
    <span class="cloud cloud--3" aria-hidden="true"></span>
    <span class="cloud cloud--4" aria-hidden="true"></span>
    <span class="cloud cloud--5" aria-hidden="true"></span>
  
  <TitleSection />
  <HistorySection />
  <VisionMissionSection />
  <ValuesSection />

  </main>
</Layout>
