---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import { seo } from "../data/seo";
import { company } from "../data/company";
import SpeedDial from "../components/SpeedDial.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = seo.meta.title.default, 
  description = seo.meta.description.default,
  image = "/images/logo4.jpeg" // Asegúrate de tener este path
} = Astro.props;

const siteUrl = seo.site.url;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultImage = image;

const organizationSchema = seo.schema.organization;
const medicalClinicSchema = seo.schema.medicalBusiness;

// --- SCHEMA.ORG: AUTORIDAD MÉDICA ---
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": "Pediátria Dharma",
  "alternateName": "Clínica Pediátrica Dra. Amalia Luque",
  "description": description,
  "url": siteUrl,
  "logo": siteUrl + "/images/logo4.jpeg",
  "image": siteUrl + image,
  "telePresence": company.contact.linkWhatsapp,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": company.address.street,
    "addressLocality": "Ayacucho",
    "addressRegion": "Ayacucho",
    "addressCountry": "PE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-13.1588",
    "longitude": "-74.2239"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "20:00"
    }
  ],
  "medicalSpecialty": "Pediatrics"
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
       <!-- Favicon -->
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" href="/icon.png" />
    <link rel="shortcut icon" href="/icon.png" />
    <link rel="apple-touch-icon" href="icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={seo.meta.author} />
    <meta name="publisher" content={seo.meta.publisher} />
    <meta name="copyright" content={seo.meta.copyright} />
    <meta name="language" content={seo.site.language} />
    <meta
      name="robots"
      content={`index, follow${seo.meta.robots.noarchive ? ", noarchive" : ""}`}
    />
    <meta name="revisit-after" content="7 days" />
    
   <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={seo.openGraph.type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + defaultImage} />
    <meta property="og:locale" content={seo.openGraph.locale} />
   <!--  <meta
      property="og:locale:alternate"
      content={seo.openGraph.localeAlternate[0]}
    /> -->
    <meta property="og:site_name" content={seo.openGraph.siteName} />

    <!-- Keywords -->
    <meta name="keywords" content={seo.meta.keywords.join(", ")} />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

     <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome - Load asynchronously -->
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"></noscript>

    <!-- Material Icons -->
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(medicalClinicSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(medicalClinicSchema)}
    />

  </head>

  <body class="bg-[#FDFDFF] text-slate-900 antialiased font-jakarta selection:bg-brand-pink/20 selection:text-brand-pink overflow-x-hidden">
    
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <SpeedDial />

    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";

      const initAOS = () => {
        AOS.init({
          duration: 800, // Un poco más rápido mejora la sensación de fluidez
          once: true,
          easing: 'ease-out-quad',
          offset: 80,
          // Esta línea detecta si es móvil y puede desactivar AOS si lo prefieres
          // disable: window.innerWidth < 768 
        });
      };

      initAOS();

      // Reinicializar tras la transición de página de Astro
      document.addEventListener("astro:after-swap", () => {
        initAOS();
        // Forzar un refresh de las posiciones de los elementos
        AOS.refresh();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --brand-pink: #E91E63;
    --brand-orange: #FF9800;
    --brand-yellow: #FFEB3B;
    --brand-green: #8BC34A;
    --brand-blue: #2196F3;
    --font-main: 'Plus Jakarta Sans', sans-serif;
  }
  

  body { font-family: var(--font-main); }

  /* Utilidades Premium */
  .glass-card {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 8px 32px rgba(31,38,135,0.05);
  }

  .text-gradient {
    background: linear-gradient(to right, var(--brand-blue), var(--brand-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }


  /* Animaciones */
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob { animation: blob 15s infinite alternate ease-in-out; }
  .animation-delay-2000 { animation-delay: 2s; }

  @keyframes reveal-text {
    from { letter-spacing: 1.2em; opacity: 0; }
    to { letter-spacing: 0.6em; opacity: 1; }
  }
  .animate-reveal-text { animation: reveal-text 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  /* Evita que los elementos se vean antes de animarse */
  [data-aos] {
    pointer-events: none;
  }
  .aos-animate {
    pointer-events: auto;
  }

  /* Mobile AOS: Disabled globally, enabled + proper initial states for index */
  @media (max-width: 768px) {
    [data-aos] {
      transition-property: none !important;
      transform: none !important;
      opacity: 1 !important;
      animation: none !important;
    }
    
    /* Full AOS restore for index mobile */
    .aos-mobile-enabled [data-aos] {
      transition-property: transform opacity !important;
      opacity: 0 !important; /* AOS initial state */
    }
    .aos-mobile-enabled [data-aos].aos-animate {
      opacity: 1 !important;
      transform: none !important;
    }
    
    /* Mobile optimizations: shorter/faster */
    .aos-mobile-enabled [data-aos] {
      transition-duration: 600ms !important;
    }
  }
</style>

