---
import { company } from "../data/company";

const currentYear = new Date().getFullYear();

// 1. Navegación
const navLinks = [
  { name: "Inicio", href: "/", icon: "fa-house" },
  { name: "Nosotros", href: "/nosotros", icon: "fa-circle-info" },
  { name: "Servicios", href: "/servicios", icon: "fa-hand-holding-medical" },
  { name: "Equipo", href: "/equipo", icon: "fa-user-doctor" },
  { name: "Blogs", href: "/blogs", icon: "fa-newspaper" },
];

// 2. Redes Sociales
const socialLinks = [
  { platform: "facebook", url: company.social.facebook, color: "hover:bg-blue-600" },
  { platform: "instagram", url: company.social.instagram, color: "hover:bg-pink-500" },
  { platform: "whatsapp", url: company.contact.linkWhatsapp, color: "hover:bg-green-500" },
  { platform: "tiktok", url: company.social.tiktok, color: "hover:bg-blue-700" },
];

// 3. Horarios Modularizados
const schedule = [
  { days: "Lun — Vie", hours: "8:00 - 20:00", isClosed: false },
  { days: "Sábados", hours: "9:00 - 14:00", isClosed: false },
  { days: "Domingos", hours: "Cerrado", isClosed: true },
];
---

<footer class="bg-[#5086c1] text-white pt-20 pb-10 relative overflow-hidden">
  <div class="max-w-380 mx-auto px-6 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-20">
      
      <div class="flex flex-col gap-8 items-center md:items-start text-center md:text-left">
        <div class="bg-white p-4 rounded-[2.5rem] inline-block shadow-2xl transform -rotate-2 hover:rotate-0 transition-all duration-500 group">
          <img src="/images/logo3.png" alt="Logo" class="h-24 object-contain group-hover:scale-105 transition-transform" />
        </div>
        <p class="text-sm leading-relaxed opacity-90 font-medium">
          Dedicados a brindar salud integral y bienestar a los más pequeños, con la calidez que tu familia merece en {company.address.city || "Ayacucho"}.
        </p>
        
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a 
              href={social.url} 
              target="_blank" 
              rel="noopener" 
              class={`w-11 h-11 rounded-2xl flex items-center justify-center bg-white/10 text-white transition-all hover:-translate-y-2 shadow-lg ${social.color}`}
            >
              <i class={`fa-brands fa-${social.platform} text-xl`}></i>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-lg font-black mb-10 border-l-4 border-[#98D8AA] pl-5 uppercase tracking-[0.2em] text-[11px]">Explorar</h4>
        <ul class="space-y-5">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="group flex items-center gap-4 text-sm font-bold opacity-80 hover:opacity-100 transition-all">
                <div class="w-8 h-8 rounded-xl bg-white/5 flex items-center justify-center group-hover:bg-[#98D8AA] group-hover:text-[#5086c1] transition-all">
                  <i class={`fa-solid ${link.icon} text-xs`}></i>
                </div>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-black mb-10 border-l-4 border-[#A8D8EA] pl-5 uppercase tracking-[0.2em] text-[11px]">Contacto</h4>
        <ul class="space-y-6 text-sm">
          <li class="flex items-start gap-4 group">
            <div class="w-10 h-10 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 group-hover:bg-[#A8D8EA] group-hover:text-[#5086c1] transition-all">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <span class="font-medium pt-1">
              {company.address.street}<br/>
              <span class="text-[10px] opacity-60 uppercase tracking-widest">{company.address.district}</span>
            </span>
          </li>
          <li class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 group-hover:bg-[#A8D8EA] group-hover:text-[#5086c1] transition-all">
              <i class="fa-solid fa-phone"></i>
            </div>
            <span class="font-bold">{company.contact.phone}</span>
          </li>
          <li class="flex items-center gap-4 group">
            <div class="w-10 h-10 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 group-hover:bg-[#A8D8EA] group-hover:text-[#5086c1] transition-all">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <span class="font-medium break-all">{company.contact.email}</span>
          </li>
        </ul>
      </div>

     <div>
        <!-- Se eliminó text-lg para mantener los 11px definidos al final -->
        <h4 class="font-black mb-10 border-l-4 border-[#FFB7C5] pl-5 uppercase tracking-[0.2em] text-[11px] text-slate-800">
          Horario
        </h4>

        <div class="relative z-10">
          <!-- Se cambió el borde a slate-100 para que sea sutil pero visible -->
          <div class="bg-white p-2 rounded-[2.5rem] animate-slide-in-left animation-delay-400 border border-slate-100 shadow-xl">
            <div class="flex items-center">
              <!-- Añadido rounded para seguir la estética y alt para SEO/Accesibilidad -->
              <img 
                src="dhar/horario.jpeg" 
                alt="Horario de atención" 
                class="w-full h-auto rounded-[2.2rem] object-cover"
              >
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="border-t border-white/10 pt-10 flex flex-col lg:flex-row justify-between items-center gap-8 text-[10px] font-black uppercase tracking-[0.2em]">
      <div class="flex items-center gap-2 opacity-60">
        <i class="fa-solid fa-shield-halved text-blue-300"></i>
        <p>© {currentYear} {company.name} — Diseñado y Desarrollado por <spam class="font-bold">JHON QP</spam></p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-8">
        <a href="/legales/aviso-legal" class="hover:text-pink-300 transition-colors">Aviso Legal</a>
        <a href="/legales/privacidad" class="hover:text-yellow-300 transition-colors">Privacidad</a>
        <a href="/legales/terminos" class="hover:text-blue-300 transition-colors">Términos</a>
      </div>
    </div>
  </div>

<div
    class="h-1.5 w-full bg-[linear-gradient(to_right,#FFB7C5,#FFEAA7,#A8D8EA)] mt-8"
  >
  </div></footer>