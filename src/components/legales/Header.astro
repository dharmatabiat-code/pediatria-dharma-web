---
// HeaderLegal.astro
import { company } from "../../data/company";
import NavDesktop from "../legales/header/NavDesktop.astro";
import NavMobile from "../legales/header/NavMobile.astro";

const pathname = new URL(Astro.request.url).pathname;

// Generación dinámica
const baseNavItems = [
  { label: "Aviso Legal", href: "/legales/aviso-legal" },
  { label: "Privacidad", href: "/legales/privacidad" },
  { label: "Términos", href: "/legales/terminos" },
];

// Detectar activo automáticamente
const navItems = baseNavItems.map(item => ({
  ...item,
  active: pathname === item.href
}));

// Mobile añade contacto
const navItemsMobile = [
  ...navItems,
  { label: "Contacto", href: "/legales/contacto", active: pathname === "/legales/contacto" }
];

// Redes (seguro ante undefined)
const socialLinks = [
  { icon: "facebook-f", url: company?.social?.facebook || "#" },
  { icon: "instagram", url: company?.social?.instagram || "#" },
];
---

<header
  id="main-header"
  class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 transition-all duration-500"
>

  <div class="max-w-7xl mx-auto px-4">

    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a 
        href="/" 
        class="flex items-center gap-2 group" 
        aria-label={`Volver al inicio - ${company.name}`}
      >
        <img 
          src="/images/logo3.png" 
          alt={`${company.name} logo`} 
          class="h-14 md:h-16 w-auto object-contain transition-all duration-300 group-hover:brightness-110"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Nav Desktop -->
      <NavDesktop navItems={navItems} />

      <!-- Botón móvil -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-600 hover:text-[#5086c1] hover:bg-gray-50 rounded-lg transition-all duration-300"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <div class="w-6 h-5 flex flex-col justify-between">
          <span class="w-full h-[2px] bg-current transition-all"></span>
          <span class="w-full h-[2px] bg-current transition-all"></span>
          <span class="w-full h-[2px] bg-current transition-all"></span>
        </div>
      </button>

    </div>

  </div>
</header>

<!-- Nav Mobile -->
<NavMobile navItems={navItemsMobile} socialLinks={socialLinks} />

<script>
  import { initHeaderLegales } from "../../scripts/header-legales.ts";
  initHeaderLegales();
</script>
