---
import { company } from "../../../data/company";

interface Props {
  navItems: { label: string; href: string }[];
  socialLinks: { icon: string; url: string }[];
}

const { navItems, socialLinks } = Astro.props;
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-60 bg-slate-900/40 backdrop-blur-md opacity-0 invisible transition-all duration-500 lg:hidden"
>
  <div
    id="mobile-menu-sidebar"
    class="absolute top-0 right-0 h-full w-[85%] max-w-sm bg-white shadow-[-20px_0_60px_rgba(0,0,0,0.1)] translate-x-full transition-transform duration-700 cubic-bezier(0.16, 1, 0.3, 1) p-10 flex flex-col"
  >
    <div class="flex justify-between items-center mb-16">
      <img src="/images/logo3.png" class="h-10 w-auto" alt="Dharma" width="235" height="64" />
      <button
        id="mobile-menu-close"
        class="text-slate-900 p-2 hover:rotate-90 transition-transform"
        aria-label="Cerrar menú"
      >
        <i class="fas fa-times text-2xl font-light"></i>
      </button>
    </div>

    <nav class="flex flex-col gap-8" role="navigation" aria-label="Navegación móvil">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link text-11px font-lefth text-slate-900 hover:text-[#5086c1] transition-all flex items-center justify-between group"
        >
          {item.label}
          <i class="fas fa-chevron-right text-xs opacity-20 group-hover:opacity-100 group-hover:translate-x-2 transition-all" />
        </a>
      ))}
      <div class="mt-12 pt-10 border-t justify-center border-slate-100 space-y-10">
        <div class="space-y-4">
          <div class="space-y-4 justify-center">
           <p class="text-slate-400 text-[10px] tracking-[0.2em] uppercase font-bold text-center">
              Huamanga - Ayacucho, Perú
            </p>
          </div>
          {company.contact.linkWhatsapp && (
            <a
              href={company.contact.linkWhatsapp}
              class="w-full bg-slate-900 text-white font-bold py-5 rounded-2xl flex items-center justify-center gap-3 text-sm shadow-xl transition-all duration-300 hover:bg-slate-800 hover:shadow-2xl hover:shadow-slate-200 active:scale-[0.98]"
            >
              WHATSAPP DIRECTO
            </a>
          )}
        </div>

        <div class="space-y-4 justify-center">
           <p class="text-slate-400 text-[10px] tracking-[0.2em] uppercase font-bold text-center">
            Síguenos en redes</p>
          </p>
          <div class="flex flex-wrap items-center gap-3">
            {socialLinks.filter(social => social.url).map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-400 transition-all duration-500 hover:bg-white hover:border-[#5086c1] hover:text-amber-600 hover:-translate-y-1 hover:shadow-lg hover:shadow-amber-500/10"
                aria-label={`Visitar ${social.icon} en redes sociales`}
              >
                <i class={`fab fa-${social.icon} text-base`} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>
  </div>

  <style>
    .mobile-nav-link {
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
  </style>
</div>