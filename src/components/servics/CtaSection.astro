---
import { company } from "../../data/company";
// Puedes pasar props si quieres personalizar el texto
const { 
  title = "¿Listo para brindarle la mejor atención a tu pequeño?", 
  subtitle = "Estamos ubicados en el corazón de Ayacucho, listos para acompañar el crecimiento saludable de tus hijos con especialistas de primer nivel.",
} = Astro.props;
---

<section class="py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="relative overflow-hidden rounded-[4rem] bg-slate-900 shadow-[0_50px_100px_rgba(0,0,0,0.2)]">
      
      <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[600px] h-[600px] bg-purple-600/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/3 w-[500px] h-[500px] bg-blue-500/20 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="relative z-10 grid lg:grid-cols-2 items-center">
        
        <div class="p-10 lg:p-20">
          <span class="inline-block px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-black uppercase tracking-[0.3em] mb-6">
            Atención Inmediata
          </span>
          
          <h2 class="text-4xl lg:text-6xl font-black text-white tracking-tighter leading-[1.1] mb-8">
            {title}
          </h2>
          
          <p class="text-slate-400 text-lg lg:text-xl font-medium leading-relaxed mb-10 max-w-md">
            {subtitle}
          </p>

          <div class="flex flex-col sm:flex-row gap-5">
            <a 
              href={company.contact.linkWhatsapp}
              class="group inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl bg-white text-slate-900 font-black text-base hover:bg-purple-500 hover:text-white transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(168,85,247,0.4)]"
            >
              <i class="fa-brands fa-whatsapp text-xl"></i>
              Agendar ahora
            </a>
            
            <a 
              href="/contacto" 
              class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-2xl border-2 border-slate-700 text-white font-black text-base hover:bg-slate-800 transition-all duration-300"
            >
              Ver ubicación
              <i class="fa-solid fa-location-dot opacity-50"></i>
            </a>
          </div>
        </div>

        <div class="relative h-full min-h-[400px] hidden lg:block">
          <div class="absolute inset-0 p-12">
            <div class="relative h-full rounded-[3rem] overflow-hidden border border-white/10">
                {/* Aquí iría una foto del equipo médico o la clínica */}
                <img 
                    src="/images/service-nebulization.jpg" 
                    alt="Pediatría Dharma" 
                    class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700"
                />
                <div class="absolute inset-0 bg-linear-to-t from-slate-900 via-transparent to-transparent"></div>
                
                <div class="absolute bottom-8 left-8 right-8 p-6 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20">
                    <div class="flex items-center gap-4">
                        <div class="flex -space-x-3">
                            <div class="w-10 h-10 rounded-full border-2 border-slate-900 bg-slate-200"></div>
                            <div class="w-10 h-10 rounded-full border-2 border-slate-900 bg-slate-300"></div>
                            <div class="w-10 h-10 rounded-full border-2 border-slate-900 bg-slate-400"></div>
                        </div>
                        <p class="text-white text-sm font-bold">
                            +500 papás confían en nosotros
                        </p>
                    </div>
                </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>