---
// ContactMapCard.astro
const { company } = Astro.props;
---

<div 
  data-aos="zoom-in" 
  class="relative overflow-hidden rounded-[3rem] lg:rounded-[4rem] group border-8 border-slate-50 h-180 m-2" 
  id="map-card"
>
  <iframe
    src={company.address.mapFrame}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
  ></iframe>


  <div class="absolute inset-x-0 bottom-10 flex justify-center">
    <a
      href={company.address.mapLink}
      class="group/btn inline-flex items-center gap-4 bg-white/90 backdrop-blur-xl text-slate-900 px-8 py-4 rounded-4xl font-black text-[10px] uppercase tracking-[0.2em] hover:bg-slate-900 hover:text-white transition-all duration-500 shadow-2xl shadow-slate-900/10 active:scale-95"
      aria-label="Abrir ubicación en Google Maps"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center group-hover/btn:bg-orange-500 transition-colors duration-500">
        <i class="fa-solid fa-location-arrow text-orange-600 group-hover/btn:text-white text-xs"></i>
      </div>
      <span>Cómo llegar a la sede</span>
    </a>
  </div>
</div>

